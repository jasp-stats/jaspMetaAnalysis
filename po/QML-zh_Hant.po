msgid "Title"

msgstr "標題"
msgctxt "ForestPlotStudyInformation|"
msgid "Width"

msgstr "寬度"
msgctxt "ForestPlotStudyInformation|"
msgid "Alignment"

msgstr "對齊"
msgctxt "ForestPlotStudyInformation|"
