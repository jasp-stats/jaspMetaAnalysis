msgstr "Bonett 反向 α"
msgctxt "ForestPlot|"
msgid "Z to R²"

msgstr "Z 轉 R²"
msgctxt "ForestPlot|"
msgid "SMD to Cohen's U₁"

msgstr "SMD 轉科恩 U₁"
msgctxt "ForestPlot|"
msgid "SMD to Cohen's U₂"

msgstr "SMD 轉科恩 U₂"
msgctxt "ForestPlot|"
msgid "SMD to Cohen's U₃"

msgstr "SMD 轉科恩 U₃"
msgctxt "ForestPlot|"
msgid "SMD to CLES, Pr(superiority)"

msgstr "SMD 轉 CLES，Pr（優越性）"
