msgid "Study Information"

msgstr "研究資訊"
msgctxt "ForestPlot|"
msgid "Estimate Information"

msgstr "估計資訊"
msgctxt "ClassicalGeneralizedMetaAnalysisAdvanced|"
msgid "Advanced"

msgstr "進階"
msgctxt "ClassicalGeneralizedMetaAnalysisAdvanced|"
msgid "Advanced options for the generalized (GLMM) meta-analysis."

msgstr "廣義（GLMM）統合分析的進階選項。"
msgctxt "ClassicalGeneralizedMetaAnalysisAdvanced|"
msgid "Show metafor R code"

msgstr "顯示 metafor R 程式碼"
msgctxt "ClassicalGeneralizedMetaAnalysisAdvanced|"
msgid "Display the underlying metafor R code used for the analysis."

msgstr "顯示分析所用的底層 metafor R 程式碼。"
msgctxt "ClassicalGeneralizedMetaAnalysisAdvanced|"
msgid "Subgroup Analysis"

msgstr "子群分析"
msgctxt "ClassicalGeneralizedMetaAnalysisAdvanced|"
