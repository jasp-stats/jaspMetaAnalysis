msgid "Left"

msgstr "左方"
msgctxt "ForestPlotSettings|"
msgid "Middle"

msgstr "中間"
msgctxt "ForestPlotSettings|"
msgid "Right"

msgstr "右方"
msgctxt "ForestPlotSettings|"
msgid "Subgroup"

msgstr "子群"
msgctxt "ForestPlotSettings|"
msgid "Specify the forest plot behavior for subgroup analysis."

msgstr "指定子群分析的森林圖行為。"
msgctxt "ForestPlotSettings|"
msgid "Show subgroup titles"

msgstr "顯示子群標題"
