msgstr "對數勝算轉 SMD（常態）"
msgctxt "ForestPlot|"
msgid "Log odds to SMD (logistic)"

msgstr "對數勝算轉 SMD（邏輯）"
msgctxt "ForestPlot|"
msgid "SMD to log odds (normal)"

msgstr "SMD 轉對數勝算（常態）"
msgctxt "ForestPlot|"
msgid "SMD to log odds (logistic)"

msgstr "SMD 轉對數勝算（邏輯）"
msgctxt "ForestPlot|"
msgid "Hakstian & Whalen inverse α"

msgstr "Hakstian 與 Whalen 反向 α"
