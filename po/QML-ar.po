msgid "Add cluster size column"
msgstr "إضافة عمود لحجم العنقود"

msgctxt "EffectSizeAggregation|"
msgid "Add a column with the number of effect sizes per cluster."
msgstr "إضافة عمود بعدد أحجام الأثر لكل عنقود."

