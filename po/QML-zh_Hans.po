msgctxt "FunnelPlot|"
msgid "Select the method for the trim-and-fill adjustment."
msgstr "选择用于修剪与填充调整的方法。"

msgctxt "FunnelPlot|"
msgid "L0"
msgstr "L0"

msgctxt "FunnelPlot|"
msgid "R0"
msgstr "R0"

msgctxt "FunnelPlot|"
msgid "Q0"
msgstr "Q0"

