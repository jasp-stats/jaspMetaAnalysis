\item{estimatedMarginalMeansHeterogeneitySdFactorCovariates, }{Standard deviation factor for covariates when computing estimated marginal means; applies to scale variables.}

\item{estimatedMarginalMeansHeterogeneitySelectedVariables, }{Variables selected for computing estimated marginal means in the heterogeneity model. Unavailable when performing multilevel/multivariate meta-analysis.}

\item{estimatedMarginalMeansHeterogeneityTransformation, }{Transformation to apply to the heterogeneity estimate: tau (𝜏) or tau-squared (𝜏²).}

