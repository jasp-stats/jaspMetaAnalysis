\item{diagnosticsPlotsProfileLikelihood, }{Include a profile likelihood plot for the heterogeneity parameter (τ²). Unavailable for equal effects, fixed effects, and unrestricted weighted least squares models.
Defaults to \code{FALSE}.}

\item{diagnosticsResidualFunnel, }{Include a residual funnel plot. Note that residual funnel plot is always based on the non-clustered model.
Defaults to \code{FALSE}.}

\item{diagnosticsVarianceInflationFactor, }{Include variance inflation factors to assess multicollinearity among predictors. Available when predictors are included in the model.
Defaults to \code{FALSE}.}

\item{diagnosticsVarianceInflationFactorAggregate, }{Aggregate variance inflation factors by terms instead of individual coefficients.
Defaults to \code{TRUE}.}

\item{effectSize, }{Variable containing the observed effect sizes.}

